{
  "name": "personal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-blog.mjs",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 50",
    "lint:fix": "eslint src --fix",
    "lint:ci": "eslint src --max-warnings 100",
    "preview": "vite preview",
    "test": "npm run test:blog && npm run build",
    "audit:security": "npm audit --audit-level moderate",
    "audit:deps": "npm outdated",
    "analyze": "npx vite-bundle-analyzer dist/stats.html",
    "test:blog": "node --test tests/blog.test.mjs"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "motion": "^13.4.5",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
